########################################
# HYPERLIQUID USDC WITHDRAW - ENVIRONMENT
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file to git.
########################################

# Private key of your Hyperliquid MASTER account (the same key behind the
# MetaMask wallet you use to log into Hyperliquid).
# Withdrawals MUST be signed by the master account key — an API/agent wallet
# (the kind trading bots normally use) is not permitted to withdraw funds.
PRIVATE_KEY=0xyourmasteraccountprivatekeyhere

# Default destination address for withdrawals (Arbitrum). This can be ANY
# address, not necessarily one you control — Hyperliquid's withdraw action
# lets you specify an arbitrary destination directly.
# You can also override this per-withdrawal in the UI.
DESTINATION_ADDRESS=0xYourDestinationAddressHere

# Local server port. The server only ever binds to 127.0.0.1 (localhost) —
# never change this to listen on 0.0.0.0 or expose it publicly.
PORT=3000
