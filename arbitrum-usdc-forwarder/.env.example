########################################
# ARBITRUM USDC FORWARDER - ENVIRONMENT
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file to git.
########################################

### --- Network ---
# Arbitrum One HTTP RPC endpoint (Alchemy, Infura, QuickNode, official Arbitrum RPC, etc.)
RPC_URL=https://arb1.arbitrum.io/rpc

# Optional: Arbitrum WebSocket RPC endpoint, used ONLY as a low-latency "wake up
# and poll now" trigger. Polling via getLogs remains the source of truth, so this
# is optional but recommended for faster reaction time. Leave blank to disable.
RPC_WS_URL=wss://arb1.arbitrum.io/ws

# Chain ID for Arbitrum One (42161) — used as a sanity check against the RPC.
CHAIN_ID=42161

### --- Wallet / Secrets ---
# Private key of the MetaMask wallet that receives Hyperliquid withdrawals.
# NEVER hardcode this anywhere else. Loaded only from this .env file (or your
# secrets manager in production — see README "Security recommendations").
PRIVATE_KEY=0xyourprivatekeyhere

# Destination wallet that should receive 100% of forwarded USDC.
DESTINATION_ADDRESS=0xYourDestinationWalletAddressHere

### --- Token ---
# USDC (native, Circle-issued) contract address on Arbitrum One.
USDC_CONTRACT_ADDRESS=0xaf88d065e77c8cC2239327C5EDb3A432268e5831

### --- Monitoring behavior ---
# How often (ms) the bot polls for new Transfer logs. 5000-10000 recommended.
POLL_INTERVAL_MS=7000

# Number of block confirmations to wait before treating a deposit as final
# and forwarding funds. Arbitrum is fast/cheap; 3-5 is a reasonable default.
CONFIRMATIONS=3

# Block to start scanning from on first boot. Leave blank to start from
# "current block" (recommended) so the bot doesn't replay old history.
START_BLOCK=

### --- Gas ---
# Percentage buffer added on top of the estimated gas limit, e.g. 20 = +20%.
GAS_LIMIT_BUFFER_PERCENT=20

# Minimum ETH (in ether, e.g. "0.002") the wallet should hold to reliably pay
# gas for a forward transaction. Purely a monitoring/alerting threshold —
# the bot WARNS and notifies if the balance drops below this, it does not
# auto-refill ETH. See README for why the wallet needs ETH at all.
MIN_ETH_RESERVE=0.001

# Max number of retry attempts for a failed/stuck transfer transaction.
TX_MAX_RETRIES=3

# Base delay (ms) for exponential backoff between retry attempts.
TX_RETRY_BASE_DELAY_MS=3000

### --- Persistence ---
# Directory used to persist processed-tx dedup state and last scanned block
# across restarts. Mount this as a Docker volume in production.
DATA_DIR=./data

### --- Health check server ---
HEALTH_CHECK_PORT=3000

### --- Logging ---
LOG_LEVEL=info
LOG_DIR=./logs

### --- Notifications (all optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DISCORD_WEBHOOK_URL=

SLACK_WEBHOOK_URL=
